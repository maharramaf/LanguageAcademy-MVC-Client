@model CourseDetailUIVM
@{
    ViewData["Title"] = Model.Title;
    var image = string.IsNullOrWhiteSpace(Model.Image)
        ? "/images/course-beginner.jpg"
        : (Model.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.Image : "/" + Model.Image.TrimStart('/'));
}

<section class="section">
    <div class="container">
        <p class="eyebrow">@Model.Type · @Model.Level</p>
        <h1>@Model.Title</h1>
        <p class="lead">@Model.Summary</p>
        <p>@Model.Overview</p>
        <ul class="course-meta">
            <li><i class="bi bi-clock"></i> @Model.Duration</li>
            <li><i class="bi bi-tag"></i> ₼@Model.Price.ToString("0")</li>
        </ul>

        @if (!string.IsNullOrWhiteSpace(Model.Video))
        {
            <div class="video-embed-wrap" style="max-width:860px;margin:24px 0;aspect-ratio:16/9;position:relative;background:#111;border-radius:12px;overflow:hidden;">
                <iframe class="video-embed" src="@Model.Video" title="@Model.Title" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
            </div>
        }
        else
        {
            <img src="@image" alt="@Model.Title" width="860" style="max-width:100%;border-radius:12px;margin:24px 0;">
        }

        @if (Model.Outcomes.Any())
        {
            <h2>What you will learn</h2>
            <ul class="learn-list">
                @foreach (var item in Model.Outcomes)
                {
                    <li><i class="bi bi-check-circle-fill"></i><span>@item</span></li>
                }
            </ul>
        }

        <h2>Curriculum</h2>
        <div class="course-modules" data-course-curriculum>
            @foreach (var module in Model.Modules.OrderBy(m => m.Order))
            {
                <div class="course-module">
                    <button class="course-module-toggle" type="button">
                        <span><strong>@module.Title</strong><small>@module.Info</small></span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="course-module-panel">
                        @foreach (var lesson in module.Lessons.OrderBy(m => m.Order))
                        {
                            <div class="lesson-row">
                                <i class="bi @(lesson.Kind == "video" ? "bi-play-circle" : lesson.Kind == "quiz" ? "bi-patch-question" : "bi-file-text")"></i>
                                <div>
                                    <strong>@lesson.Title</strong>
                                    <span>@lesson.Kind</span>
                                </div>
                            </div>
                            @if (lesson.Kind == "video" && !string.IsNullOrWhiteSpace(lesson.Video))
                            {
                                var remote = lesson.Video.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                                var src = remote ? lesson.Video : "/" + lesson.Video.TrimStart('/');
                                <div class="video-embed-wrap" style="margin:8px 0 16px;aspect-ratio:16/9;position:relative;background:#111;border-radius:12px;overflow:hidden;">
                                    @if (remote)
                                    {
                                        <iframe class="video-embed" src="@src" title="@lesson.Title" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
                                    }
                                    else
                                    {
                                        <video class="video-embed" src="@src" title="@lesson.Title" controls playsinline style="position:absolute;inset:0;width:100%;height:100%;border:0;"></video>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @if (Model.Reviews.Any())
        {
            <h2>What learners say</h2>
            <div class="review-list" style="max-width:860px;">
                @foreach (var review in Model.Reviews)
                {
                    var photo = string.IsNullOrWhiteSpace(review.Photo)
                        ? "/images/student-amira.jpg"
                        : (review.Photo.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? review.Photo : "/" + review.Photo.TrimStart('/'));
                    <div class="testimonial-card" style="margin-bottom:16px;">
                        <div class="stars" aria-label="Rated @review.Rating out of 5">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </div>
                        <p class="quote">@review.Text</p>
                        <div class="t-top">
                            <img src="@photo" alt="@review.PhotoAlt" width="80" height="80">
                            <div>
                                <h3>@review.Name</h3>
                                <p>@review.Course</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <p style="margin-top:24px;"><a class="btn btn-outline" asp-controller="Courses" asp-action="Index">Back to courses</a></p>
    </div>
</section>
