<main>
    @await Component.InvokeAsync("Hero")


    @await Component.InvokeAsync("Course")


    @await Component.InvokeAsync("About")


    <section id="features-section" class="section">
        <div class="container">
            <div class="section-header center reveal">
                <span class="eyebrow" data-i18n="why_eyebrow">Why choose us</span>
                <h2 data-i18n="why_title">A school built around speaking</h2>
                <p><span data-i18n="xxslqii">The method is simple: small groups, useful materials, and teachers who know how adults actually learn.</span></p>
            </div>
            <div class="feature-grid">
                <div class="why-card reveal">
                    <div class="icon-bubble"><i class="bi bi-person-workspace"></i></div>
                    <h3 data-i18n="feat_teachers">Expert Teachers</h3>
                    <p><span data-i18n="x128cq2r">Certified instructors with classroom experience and clear, kind feedback.</span></p>
                </div>
                <div class="why-card reveal">
                    <div class="icon-bubble"><i class="bi bi-calendar2-week"></i></div>
                    <h3 data-i18n="feat_schedule">Flexible Schedule</h3>
                    <p><span data-i18n="xklpuoj">Morning, evening, and weekend groups so study fits around work.</span></p>
                </div>
                <div class="why-card reveal">
                    <div class="icon-bubble"><i class="bi bi-laptop"></i></div>
                    <h3 data-i18n="feat_online">Online Learning</h3>
                    <p><span data-i18n="x10i779d">Live online classes use the same plan as the Boston campus.</span></p>
                </div>
                <div class="why-card reveal">
                    <div class="icon-bubble"><i class="bi bi-award"></i></div>
                    <h3 data-i18n="feat_certificate">Certificate</h3>
                    <p><span data-i18n="x1wz40k5">Finish the course and receive a MF Language Academy certificate of completion.</span></p>
                </div>
                <div class="why-card reveal">
                    <div class="icon-bubble"><i class="bi bi-people"></i></div>
                    <h3 data-i18n="feat_small">Small Classes</h3>
                    <p><span data-i18n="x1jedqj6">Groups of 8 to 12 students so there is time to speak every lesson.</span></p>
                </div>
                <div class="why-card reveal">
                    <div class="icon-bubble"><i class="bi bi-journal-richtext"></i></div>
                    <h3 data-i18n="feat_materials">Modern Materials</h3>
                    <p><span data-i18n="x17b7waa">Current topics, audio, and tasks designed for adult learners.</span></p>
                </div>
            </div>
        </div>
    </section>


    <section id="teachers-section" class="section section-alt">
        <div class="container">
            <div class="section-header center reveal">
                <span class="eyebrow" data-i18n="nav_teachers">Teachers</span>
                <h2 data-i18n="teachers_title">Learn with people who teach for a living</h2>
                <p><span data-i18n="xj7abym">Our faculty lead courses, write materials, and stay in the classroom.</span></p>
            </div>
            <div class="teacher-grid">
                <div class="teacher-card reveal">
                    <div class="teacher-photo"><img src="images/teacher-elena.jpg" alt="Portrait of Elena Marquez" data-i18n-alt="xkhyqqs" width="700" height="800"></div>
                    <div class="teacher-body">
                        <h3>Elena Marquez</h3>
                        <p class="role" data-i18n="role_elena">English Program Lead</p>
                        <p><span data-i18n="xiefkzk">Designs the beginner pathway and teaches the Monday speaking lab.</span></p>
                        <div class="teacher-social">
                            <a href="#" aria-label="Elena on LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="Elena on Instagram"><i class="bi bi-instagram"></i></a>
                        </div>
                        <button class="btn btn-sm btn-outline" type="button" style="margin-top:12px;" data-teacher-open data-name="Elena Marquez" data-role="English Program Lead" data-i18n-role="role_elena" data-photo="images/teacher-elena.jpg" data-bio="Elena has taught English for twelve years in Boston and Madrid. She keeps classes practical, with speaking time in every lesson and feedback students can use the same week." data-i18n-bio="x1qkodnk" data-i18n="btn_view_profile">View Profile</button>
                    </div>
                </div>
                <div class="teacher-card reveal">
                    <div class="teacher-photo"><img src="images/teacher-daniel.jpg" alt="Portrait of Daniel Okonkwo" data-i18n-alt="x1xyzu0b" width="700" height="800"></div>
                    <div class="teacher-body">
                        <h3>Daniel Okonkwo</h3>
                        <p class="role" data-i18n="role_daniel">IELTS Instructor</p>
                        <p><span data-i18n="x1em3wm5">Coaches writing and speaking with calm, timed exam practice.</span></p>
                        <div class="teacher-social">
                            <a href="#" aria-label="Daniel on LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="Daniel on X"><i class="bi bi-twitter-x"></i></a>
                        </div>
                        <button class="btn btn-sm btn-outline" type="button" style="margin-top:12px;" data-teacher-open data-name="Daniel Okonkwo" data-role="IELTS Instructor" data-i18n-role="role_daniel" data-photo="images/teacher-daniel.jpg" data-bio="Daniel prepares candidates for Academic IELTS. His feedback follows the public band descriptors, so students always know why a score moved." data-i18n-bio="x93jbgu" data-i18n="btn_view_profile">View Profile</button>
                    </div>
                </div>
                <div class="teacher-card reveal">
                    <div class="teacher-photo"><img src="images/teacher-sophie.jpg" alt="Portrait of Sophie Laurent" data-i18n-alt="x1m6jcz1" width="700" height="800"></div>
                    <div class="teacher-body">
                        <h3>Sophie Laurent</h3>
                        <p class="role" data-i18n="role_sophie">Spanish Instructor</p>
                        <p><span data-i18n="xexrqfp">Brings culture, travel dialogues, and clear grammar into class.</span></p>
                        <div class="teacher-social">
                            <a href="#" aria-label="Sophie on LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="Sophie on Instagram"><i class="bi bi-instagram"></i></a>
                        </div>
                        <button class="btn btn-sm btn-outline" type="button" style="margin-top:12px;" data-teacher-open data-name="Sophie Laurent" data-role="Spanish Instructor" data-i18n-role="role_sophie" data-photo="images/teacher-sophie.jpg" data-bio="Sophie teaches beginner Spanish with a balance of conversation and structure. Students practice both Latin American and Peninsular varieties." data-i18n-bio="xz1miw8" data-i18n="btn_view_profile">View Profile</button>
                    </div>
                </div>
                <div class="teacher-card reveal">
                    <div class="teacher-photo"><img src="images/teacher-markus.jpg" alt="Portrait of Markus Weber" data-i18n-alt="x1ef3nrk" width="700" height="800"></div>
                    <div class="teacher-body">
                        <h3>Markus Weber</h3>
                        <p class="role" data-i18n="role_markus">German Instructor</p>
                        <p><span data-i18n="x1opdsc1">Makes cases and pronunciation feel manageable from week one.</span></p>
                        <div class="teacher-social">
                            <a href="#" aria-label="Markus on LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="Markus on Facebook"><i class="bi bi-facebook"></i></a>
                        </div>
                        <button class="btn btn-sm btn-outline" type="button" style="margin-top:12px;" data-teacher-open data-name="Markus Weber" data-role="German Instructor" data-i18n-role="role_markus" data-photo="images/teacher-markus.jpg" data-bio="Markus focuses on the German beginners need for transport, housing, and introductions. Grammar is taught inside short dialogues, not long lectures." data-i18n-bio="x17kzyue" data-i18n="btn_view_profile">View Profile</button>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <section id="statistics-section" class="stats">
        <div class="container stats-grid">
            <div class="stat">
                <i class="bi bi-people"></i>
                <span class="stat-number" data-count="1000" data-suffix="+">1000+</span>
                <span class="stat-label" data-i18n="nav_students">Students</span>
            </div>
            <div class="stat">
                <i class="bi bi-journal-bookmark"></i>
                <span class="stat-number" data-count="20" data-suffix="+">20+</span>
                <span class="stat-label" data-i18n="nav_courses">Courses</span>
            </div>
            <div class="stat">
                <i class="bi bi-person-badge"></i>
                <span class="stat-number" data-count="25" data-suffix="+">25+</span>
                <span class="stat-label" data-i18n="nav_teachers">Teachers</span>
            </div>
            <div class="stat">
                <i class="bi bi-mortarboard"></i>
                <span class="stat-number" data-count="10" data-suffix="+">10+</span>
                <span class="stat-label" data-i18n="stat_years">Years Experience</span>
            </div>
        </div>
    </section>


    <section id="testimonials-section" class="section">
        <div class="container">
            <div class="section-header center reveal">
                <span class="eyebrow" data-i18n="testimonials_eyebrow">Testimonials</span>
                <h2 data-i18n="testimonials_title">What students say after class</h2>
                <p><span data-i18n="xq59q3s">Real goals: a visa interview, a new team, a first conversation abroad.</span></p>
            </div>
            <div class="slider" data-slider="testimonials">
                <div class="slider-viewport">
                    <div class="slider-track">
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 5 out of 5" data-i18n-aria-label="xxg89s5">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="quote"><span data-i18n="x1h3jxfm">“The IELTS speaking labs were the first place I stopped memorizing answers. I left with a 7.5 and a calmer exam day.”</span></p>
                            <div class="t-top">
                                <img src="images/student-amira.jpg" alt="Amira Hassan" width="400" height="400">
                                <div><h3>Amira Hassan</h3><p data-i18n="course_ielts">IELTS Preparation</p></div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 5 out of 5" data-i18n-aria-label="xxg89s5">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="quote"><span data-i18n="xzmtwyw">“Business English gave me phrases I use in stand-ups every morning. The group was small enough to actually practice.”</span></p>
                            <div class="t-top">
                                <img src="images/student-luca.jpg" alt="Luca Bianchi" width="400" height="400">
                                <div><h3>Luca Bianchi</h3><p data-i18n="course_business">Business English</p></div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 4 out of 5" data-i18n-aria-label="x10p88km">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                            </div>
                            <p class="quote"><span data-i18n="x16rb0el">“I wanted Spanish for a family trip. By week six I could order, ask for directions, and understand the replies.”</span></p>
                            <div class="t-top">
                                <img src="images/student-priya.jpg" alt="Priya Shah" width="400" height="400">
                                <div><h3>Priya Shah</h3><p data-i18n="course_spanish">Spanish Language</p></div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 5 out of 5" data-i18n-aria-label="xxg89s5">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="quote"><span data-i18n="xna0sa0">“German finally clicked because Markus taught grammar inside real dialogues. I use it at the bakery near my office.”</span></p>
                            <div class="t-top">
                                <img src="images/student-noah.jpg" alt="Noah Keller" width="400" height="400">
                                <div><h3>Noah Keller</h3><p data-i18n="course_german">German Language</p></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="slider-controls">
                    <button class="slider-btn" type="button" data-prev aria-label="Previous testimonials" data-i18n-aria-label="slider_prev_stories"><i class="bi bi-arrow-left"></i></button>
                    <div class="slider-dots"></div>
                    <button class="slider-btn" type="button" data-next aria-label="Next testimonials" data-i18n-aria-label="slider_next_stories"><i class="bi bi-arrow-right"></i></button>
                </div>
            </div>
        </div>
    </section>


    <section id="cta-section" class="cta">
        <div class="container">
            <div class="cta-band reveal">
                <span class="eyebrow" style="color:#fde68a;"><span data-i18n="xjnq4nw">Start this month</span></span>
                <h2 data-i18n="cta_title">Ready to Start Learning?</h2>
                <p><span data-i18n="xn9gvkj">Join MF Language Academy and start improving your language skills today.</span></p>
                <a class="btn btn-secondary" href="register.html" data-i18n="btn_start_learning">Start Learning</a>
            </div>
        </div>
    </section>


    <section id="newsletter-section" class="section section-alt">
        <div class="container newsletter">
            <div class="section-header">
                <span class="eyebrow" data-i18n="newsletter_eyebrow">Newsletter</span>
                <h2 data-i18n="newsletter_title">Course news, in your inbox</h2>
                <p><span data-i18n="xqxy4up">New groups, exam dates, and study tips from MF Language Academy.</span></p>
            </div>
            <form class="newsletter-form" data-form="newsletter" novalidate>
                <div class="field">
                    <label for="newsletter-email" data-i18n="label_email">Email</label>
                    <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="you@email.com">
                    <p class="field-error" data-error-for="email"></p>
                </div>
                <button class="btn btn-primary" type="submit" data-i18n="btn_subscribe">Subscribe</button>
                <p class="form-note"><span data-i18n="x1ua9mvd">Preview only. Nothing is sent.</span></p>
                <div class="form-success" hidden>
                    <i class="bi bi-check-circle-fill"></i>
                    <h3 data-i18n="newsletter_success">You are on the list</h3>
                    <p><span data-i18n="x12lhryy">This preview validated your email and did not send it anywhere.</span></p>
                </div>
            </form>
        </div>
    </section>

</main>