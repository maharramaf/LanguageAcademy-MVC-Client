<main>
    @await Component.InvokeAsync("Hero")


    @await Component.InvokeAsync("Course")


    @await Component.InvokeAsync("About")


    @await Component.InvokeAsync("WhyChoose")


    @await Component.InvokeAsync("Teacher")


    <section id="statistics-section" class="stats">
        <div class="container stats-grid">
            <div class="stat">
                <i class="bi bi-people"></i>
                <span class="stat-number" data-count="1000" data-suffix="+">1000+</span>
                <span class="stat-label" data-i18n="nav_students">Students</span>
            </div>
            <div class="stat">
                <i class="bi bi-journal-bookmark"></i>
                <span class="stat-number" data-count="20" data-suffix="+">20+</span>
                <span class="stat-label" data-i18n="nav_courses">Courses</span>
            </div>
            <div class="stat">
                <i class="bi bi-person-badge"></i>
                <span class="stat-number" data-count="25" data-suffix="+">25+</span>
                <span class="stat-label" data-i18n="nav_teachers">Teachers</span>
            </div>
            <div class="stat">
                <i class="bi bi-mortarboard"></i>
                <span class="stat-number" data-count="10" data-suffix="+">10+</span>
                <span class="stat-label" data-i18n="stat_years">Years Experience</span>
            </div>
        </div>
    </section>


    <section id="testimonials-section" class="section">
        <div class="container">
            <div class="section-header center reveal">
                <span class="eyebrow" data-i18n="testimonials_eyebrow">Testimonials</span>
                <h2 data-i18n="testimonials_title">What students say after class</h2>
                <p><span data-i18n="xq59q3s">Real goals: a visa interview, a new team, a first conversation abroad.</span></p>
            </div>
            <div class="slider" data-slider="testimonials">
                <div class="slider-viewport">
                    <div class="slider-track">
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 5 out of 5" data-i18n-aria-label="xxg89s5">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="quote"><span data-i18n="x1h3jxfm">“The IELTS speaking labs were the first place I stopped memorizing answers. I left with a 7.5 and a calmer exam day.”</span></p>
                            <div class="t-top">
                                <img src="images/student-amira.jpg" alt="Amira Hassan" width="400" height="400">
                                <div><h3>Amira Hassan</h3><p data-i18n="course_ielts">IELTS Preparation</p></div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 5 out of 5" data-i18n-aria-label="xxg89s5">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="quote"><span data-i18n="xzmtwyw">“Business English gave me phrases I use in stand-ups every morning. The group was small enough to actually practice.”</span></p>
                            <div class="t-top">
                                <img src="images/student-luca.jpg" alt="Luca Bianchi" width="400" height="400">
                                <div><h3>Luca Bianchi</h3><p data-i18n="course_business">Business English</p></div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 4 out of 5" data-i18n-aria-label="x10p88km">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                            </div>
                            <p class="quote"><span data-i18n="x16rb0el">“I wanted Spanish for a family trip. By week six I could order, ask for directions, and understand the replies.”</span></p>
                            <div class="t-top">
                                <img src="images/student-priya.jpg" alt="Priya Shah" width="400" height="400">
                                <div><h3>Priya Shah</h3><p data-i18n="course_spanish">Spanish Language</p></div>
                            </div>
                        </div>
                        <div class="testimonial-card">
                            <div class="stars" aria-label="Rated 5 out of 5" data-i18n-aria-label="xxg89s5">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                            <p class="quote"><span data-i18n="xna0sa0">“German finally clicked because Markus taught grammar inside real dialogues. I use it at the bakery near my office.”</span></p>
                            <div class="t-top">
                                <img src="images/student-noah.jpg" alt="Noah Keller" width="400" height="400">
                                <div><h3>Noah Keller</h3><p data-i18n="course_german">German Language</p></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="slider-controls">
                    <button class="slider-btn" type="button" data-prev aria-label="Previous testimonials" data-i18n-aria-label="slider_prev_stories"><i class="bi bi-arrow-left"></i></button>
                    <div class="slider-dots"></div>
                    <button class="slider-btn" type="button" data-next aria-label="Next testimonials" data-i18n-aria-label="slider_next_stories"><i class="bi bi-arrow-right"></i></button>
                </div>
            </div>
        </div>
    </section>


    <section id="cta-section" class="cta">
        <div class="container">
            <div class="cta-band reveal">
                <span class="eyebrow" style="color:#fde68a;"><span data-i18n="xjnq4nw">Start this month</span></span>
                <h2 data-i18n="cta_title">Ready to Start Learning?</h2>
                <p><span data-i18n="xn9gvkj">Join MF Language Academy and start improving your language skills today.</span></p>
                <a class="btn btn-secondary" href="register.html" data-i18n="btn_start_learning">Start Learning</a>
            </div>
        </div>
    </section>


    <section id="newsletter-section" class="section section-alt">
        <div class="container newsletter">
            <div class="section-header">
                <span class="eyebrow" data-i18n="newsletter_eyebrow">Newsletter</span>
                <h2 data-i18n="newsletter_title">Course news, in your inbox</h2>
                <p><span data-i18n="xqxy4up">New groups, exam dates, and study tips from MF Language Academy.</span></p>
            </div>
            <form class="newsletter-form" data-form="newsletter" novalidate>
                <div class="field">
                    <label for="newsletter-email" data-i18n="label_email">Email</label>
                    <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="you@email.com">
                    <p class="field-error" data-error-for="email"></p>
                </div>
                <button class="btn btn-primary" type="submit" data-i18n="btn_subscribe">Subscribe</button>
                <p class="form-note"><span data-i18n="x1ua9mvd">Preview only. Nothing is sent.</span></p>
                <div class="form-success" hidden>
                    <i class="bi bi-check-circle-fill"></i>
                    <h3 data-i18n="newsletter_success">You are on the list</h3>
                    <p><span data-i18n="x12lhryy">This preview validated your email and did not send it anywhere.</span></p>
                </div>
            </form>
        </div>
    </section>

</main>