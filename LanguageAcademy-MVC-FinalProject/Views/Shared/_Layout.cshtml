<!DOCTYPE html>
<html lang="en"
      data-notify-token="@(User.Identity?.IsAuthenticated == true ? Url.Action("HubToken", "Notifications") : null)"
      data-notify-list="@Url.Action("List", "Notifications")"
      data-notify-read="@Url.Action("Read", "Notifications")"
      data-notify-read-all="@Url.Action("ReadAll", "Notifications")">
<head>
    <script src="~/js/preferences-boot.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MF Language Academy</title>
    <meta name="description" content="MF Language Academy is a modern language school for English, IELTS, German, Spanish, and professional communication.">
    <link rel="icon" href="~/images/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;0,6..12,800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/responsive.css">
</head>
<body>
    <a class="skip-link" href="@(ViewData["SkipHref"] ?? "#hero-section")" data-i18n="skip_content">Skip to content</a>
    <header class="site-header">
        <div class="topbar">
            <div class="container topbar-inner">
                <div class="topbar-left">
                    <a href="tel:+15550142280"><i class="bi bi-telephone"></i> +1 (555) 014-2280</a>
                    <a href="mailto:hello@mflanguage.academy"><i class="bi bi-envelope"></i> hello@mflanguage.academy</a>
                </div>
                <div class="topbar-right">
                    <a href="#" aria-label="Facebook" data-i18n-aria-label="social_facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Instagram" data-i18n-aria-label="social_instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="LinkedIn" data-i18n-aria-label="social_linkedin"><i class="bi bi-linkedin"></i></a>
                    <a href="#" aria-label="YouTube" data-i18n-aria-label="social_youtube"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
        </div>
        <div class="container header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <span class="logo-mark">MF</span>
                <span class="logo-text"><strong>MF Language</strong><small>Academy</small></span>
            </a>
            <nav class="nav" aria-label="Primary" data-i18n-aria-label="aria_primary">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                }
                <ul class="nav-list">
                    <li><a class="@(currentController == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index" aria-current="@(currentController == "Home" ? "page" : null)" data-i18n="nav_home">Home</a></li>
                    <li><a class="@(currentController == "About" ? "active" : null)" asp-controller="About" asp-action="Index" aria-current="@(currentController == "About" ? "page" : null)" data-i18n="nav_about">About</a></li>
                    <li><a class="@(currentController == "Courses" ? "active" : null)" asp-controller="Courses" asp-action="Index" aria-current="@(currentController == "Courses" ? "page" : null)" data-i18n="nav_courses">Courses</a></li>
                    <li><a class="@(currentController == "Teachers" ? "active" : null)" asp-controller="Teachers" asp-action="Index" aria-current="@(currentController == "Teachers" ? "page" : null)" data-i18n="nav_teachers">Teachers</a></li>
                    <li><a class="@(currentController == "Students" ? "active" : null)" asp-controller="Students" asp-action="Index" aria-current="@(currentController == "Students" ? "page" : null)" data-i18n="nav_students">Students</a></li>
                    <li><a class="@(currentController == "Contact" ? "active" : null)" asp-controller="Contact" asp-action="Index" aria-current="@(currentController == "Contact" ? "page" : null)" data-i18n="nav_contact">Contact</a></li>
                </ul>
                <div class="nav-actions">
                    <partial name="_AuthNav" />
                </div>
            </nav>
            <form class="header-search" asp-controller="Courses" asp-action="Index" method="get" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="q" placeholder="Search courses" data-i18n-placeholder="search_placeholder" aria-label="Search courses" data-i18n-aria-label="search_placeholder">
            </form>
            <div class="header-tools">
                @if (Roles.IsStudent(User))
                {
                    <a class="header-dash" asp-controller="Dashboard" asp-action="Index" aria-label="Dashboard" data-i18n-aria-label="dash_home" title="Dashboard"><i class="bi bi-grid-1x2"></i></a>
                }
                <div class="lang-switch">
                    <button class="lang-toggle" type="button" aria-haspopup="listbox" aria-expanded="false" data-i18n-aria-label="language_menu">
                        <span class="lang-current">AZ</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                    <ul class="lang-menu" role="listbox" hidden>
                        <li role="none"><button type="button" role="option" data-set-lang="az">🇦🇿 Azərbaycan</button></li>
                        <li role="none"><button type="button" role="option" data-set-lang="ru">🇷🇺 Русский</button></li>
                        <li role="none"><button type="button" role="option" data-set-lang="en">🇬🇧 English</button></li>
                    </ul>
                </div>
                <button class="theme-toggle" type="button" aria-pressed="false" data-i18n-aria-label="toggle_theme">
                    <i class="bi bi-moon-stars" aria-hidden="true"></i>
                </button>
            </div>

            <div class="header-actions">
                <partial name="_AuthNav" />
                <button class="nav-toggle" type="button" aria-label="Open menu" data-i18n-aria-label="open_menu" aria-expanded="false">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
        <div class="nav-overlay"></div>
    </header>
        @RenderBody()

    @if (ViewData["HideNewsletter"] as bool? != true)
    {
        @await Component.InvokeAsync("Newsletter")
    }

    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <a class="logo" asp-controller="Home" asp-action="Index">
                    <span class="logo-mark">MF</span>
                    <span class="logo-text"><strong>MF Language</strong><small>Academy</small></span>
                </a>
                <p style="margin-top:14px;"><span data-i18n="x1rxk271">MF Language Academy helps adults speak clearly at work, in exams, and abroad.</span></p>
            </div>
            <div>
                <h3 data-i18n="footer_quick">Quick Links</h3>
                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Index" data-i18n="nav_home">Home</a>
                    <a asp-controller="About" asp-action="Index" data-i18n="nav_about">About</a>
                    <a asp-controller="Courses" asp-action="Index" data-i18n="nav_courses">Courses</a>
                    <a asp-controller="Teachers" asp-action="Index" data-i18n="nav_teachers">Teachers</a>
                    <a asp-controller="Students" asp-action="Index" data-i18n="nav_students">Students</a>
                    <a asp-controller="Contact" asp-action="Index" data-i18n="nav_contact">Contact</a>
                </div>
            </div>
            <div>
                <h3 data-i18n="nav_courses">Courses</h3>
                <div class="footer-links">
                    <a asp-controller="Courses" asp-action="Details" asp-route-slug="english-beginner" data-i18n="course_en_beginner">English Beginner</a>
                    <a asp-controller="Courses" asp-action="Details" asp-route-slug="ielts" data-i18n="course_ielts">IELTS Preparation</a>
                    <a asp-controller="Courses" asp-action="Details" asp-route-slug="business-english" data-i18n="course_business">Business English</a>
                    <a asp-controller="Courses" asp-action="Details" asp-route-slug="german" data-i18n="course_german">German Language</a>
                    <a asp-controller="Courses" asp-action="Details" asp-route-slug="spanish" data-i18n="course_spanish">Spanish Language</a>
                </div>
            </div>
            <div>
                <h3 data-i18n="footer_contact">Contact Information</h3>
                <div class="footer-links">
                    <span><span data-i18n="x1llp0ns">250 Language Plaza, Boston</span></span>
                    <a href="tel:+15550142280">+1 (555) 014-2280</a>
                    <a href="mailto:hello@mflanguage.academy">hello@mflanguage.academy</a>
                    <span><span data-i18n="x1xusn0r">Mon–Fri 9:00–18:00</span></span>
                </div>
            </div>
            <div>
                <h3 data-i18n="footer_social">Social Media</h3>
                <div class="footer-social">
                    <a href="#" aria-label="Facebook" data-i18n-aria-label="social_facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Instagram" data-i18n-aria-label="social_instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="LinkedIn" data-i18n-aria-label="social_linkedin"><i class="bi bi-linkedin"></i></a>
                    <a href="#" aria-label="YouTube" data-i18n-aria-label="social_youtube"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
        </div>
        <div class="container footer-bottom">
            <p><span data-i18n="xuwyenm">© 2026 MF Language Academy. All rights reserved.</span></p>
            <p>
                @{
                    ViewData["AuthNavLinks"] = true;
                }
                <partial name="_AuthNav" />
                @{
                    ViewData.Remove("AuthNavLinks");
                }
            </p>
        </div>
    </footer>

    <div class="modal" data-modal="teacher" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="teacherModalName">
            <button class="modal-close" type="button" data-modal-close aria-label="Close" data-i18n-aria-label="btn_close">&times;</button>
            <div class="teacher-modal">
                <img data-teacher="photo" alt="" width="150" height="180">
                <div>
                    <h3 id="teacherModalName" data-teacher="name"></h3>
                    <p class="role" data-teacher="role"></p>
                    <p data-teacher="bio"></p>
                </div>
            </div>
        </div>
    </div>
    <button class="back-to-top" type="button" aria-label="Back to top" data-i18n-aria-label="back_to_top"><i class="bi bi-arrow-up"></i></button>
    <script src="~/js/navbar.js" defer></script>
    <script src="~/js/slider.js" defer></script>
    <script src="~/js/validation.js" defer></script>
    <script src="~/js/main.js" defer></script>
    <script src="~/js/faq-widget.js" defer></script>
    <script src="~/js/ai-assistant.js" defer></script>
    <script src="~/js/i18n-extra.js" defer></script>
    <script src="~/js/preferences.js" defer></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    }
    <script src="~/js/notifications.js" defer></script>
    <script src="~/js/membership.js" defer></script>
    <script src="~/js/certificates.js" defer></script>
    <script src="~/js/demoQuizQuestions.js" defer></script>
    <script src="~/js/demoQuiz.js" defer></script>
    <script src="~/js/checkout.js" defer></script>
</body>
</html>
