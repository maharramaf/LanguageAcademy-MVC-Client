@model StatsUIVM?
@if (Model is null) { return; }

<section id="statistics-section" class="stats">
    <div class="container stats-grid">
        <div class="stat">
            <i class="bi bi-people"></i>
            <span class="stat-number" data-count="@Model.Students" data-suffix="+">@Model.Students+</span>
            <span class="stat-label">Students</span>
        </div>
        <div class="stat">
            <i class="bi bi-journal-bookmark"></i>
            <span class="stat-number" data-count="@Model.Courses" data-suffix="+">@Model.Courses+</span>
            <span class="stat-label">Courses</span>
        </div>
        <div class="stat">
            <i class="bi bi-person-badge"></i>
            <span class="stat-number" data-count="@Model.Teachers" data-suffix="+">@Model.Teachers+</span>
            <span class="stat-label">Teachers</span>
        </div>
        <div class="stat">
            <i class="bi bi-mortarboard"></i>
            <span class="stat-number" data-count="@Model.Years" data-suffix="+">@Model.Years+</span>
            <span class="stat-label">Years Experience</span>
        </div>
    </div>
</section>
