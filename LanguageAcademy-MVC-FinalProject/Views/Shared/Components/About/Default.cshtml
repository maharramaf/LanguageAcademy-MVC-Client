@model AboutUIVM?
@if (Model is null) { return; }
@{
    var image = string.IsNullOrWhiteSpace(Model.Image)
        ? "/images/about.jpg"
        : (Model.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.Image : "/" + Model.Image.TrimStart('/'));
}

<section id="about-section" class="section">
    <div class="container about-grid">
        <div class="about-media reveal">
            <img src="@image" alt="@Model.ImageAlt" width="1200" height="900">
            <div class="about-float">
                <strong>@Model.Years</strong>
                <span>@Model.YearsText1<br>@Model.YearsText2</span>
            </div>
        </div>
        <div class="reveal">
            <span class="eyebrow">@Model.Subtitle</span>
            <h2>@Model.Title</h2>
            <p>@Model.Text1</p>
            <p>@Model.Text2</p>
            <div class="feature-list">
                <div class="feature-item"><i class="bi bi-check-circle-fill"></i> @Model.Feature1</div>
                <div class="feature-item"><i class="bi bi-check-circle-fill"></i> @Model.Feature2</div>
                <div class="feature-item"><i class="bi bi-check-circle-fill"></i> @Model.Feature3</div>
                <div class="feature-item"><i class="bi bi-check-circle-fill"></i> @Model.Feature4</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Button))
            {
                <a class="btn btn-primary" asp-controller="About" asp-action="Index" style="margin-top: 22px;">@Model.Button</a>
            }
        </div>
    </div>
</section>
