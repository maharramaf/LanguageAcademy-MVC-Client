@model HowWeWorkUIVM?
@if (Model is null) { return; }

<section id="features-section" class="section section-alt">
    <div class="container">
        <div class="section-header center reveal">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2>@Model.Title</h2>
        </div>
        <div class="value-grid">
            @foreach (var card in Model.Cards)
            {
                <div class="value-card reveal">
                    <div class="icon-bubble"><i class="@card.Icon"></i></div>
                    <h3>@card.Title</h3>
                    <p>@card.Text</p>
                </div>
            }
        </div>
    </div>
</section>
