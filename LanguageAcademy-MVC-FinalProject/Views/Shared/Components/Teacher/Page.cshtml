@model TeacherSectionUIVM?
@if (Model is null) { return; }

<section id="teachers-hero" class="page-hero">
    <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb" data-i18n-aria-label="aria_breadcrumb"><a asp-controller="Home" asp-action="Index" data-i18n="nav_home">Home</a><span>/</span><span data-i18n="nav_teachers">Teachers</span></nav>
        <span class="eyebrow">@Model.Subtitle</span>
        <h1>@Model.Title</h1>
        <p>@Model.Text</p>
    </div>
</section>

<section id="teachers-section" class="section">
    <div class="container">
        <div class="teacher-grid cols-3">
            @foreach (var teacher in Model.Teachers)
            {
                var photo = string.IsNullOrWhiteSpace(teacher.Photo)
                    ? "/images/teacher-elena.jpg"
                    : (teacher.Photo.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? teacher.Photo : "/" + teacher.Photo.TrimStart('/'));
                <div class="teacher-card reveal">
                    <div class="teacher-photo"><img src="@photo" alt="@teacher.PhotoAlt" width="700" height="800"></div>
                    <div class="teacher-body">
                        <h3>@teacher.Name</h3>
                        <p class="role">@teacher.Role</p>
                        <p>@teacher.Summary</p>
                        <div class="teacher-social">
                            <a href="@teacher.LinkedIn" aria-label="@teacher.Name on LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="@teacher.Social" aria-label="@teacher.Name"><i class="@teacher.SocialIcon"></i></a>
                        </div>
                        <button class="btn btn-sm btn-outline" type="button" style="margin-top:12px;" data-teacher-open data-name="@teacher.Name" data-role="@teacher.Role" data-photo="@photo" data-bio="@teacher.Bio">View Profile</button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
