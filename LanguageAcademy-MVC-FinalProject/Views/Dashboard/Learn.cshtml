@model CourseDetailUIVM?
@{
    Layout = "_DashLayout";
    var lessonId = ViewBag.LessonId is int id ? id : (int?)null;
    var lessons = Model?.Modules
        .OrderBy(m => m.Order)
        .SelectMany(m => m.Lessons.OrderBy(x => x.Order).Select(x => new { Module = m, Lesson = x }))
        .ToList() ?? [];
    var current = lessonId is int openId ? lessons.FirstOrDefault(m => m.Lesson.Id == openId) : null;
    var courseDone = lessons.Count > 0 && lessons.All(m => m.Lesson.Completed);
}
<div class="dash-content class-page">
    @if (Model is null)
    {
        <section class="panel">
            <h2 data-i18n="learn_continue">Continue learning</h2>
            <p>Your courses will appear here when you enroll.</p>
            <p><a class="btn btn-primary" asp-controller="Courses" asp-action="Index" data-i18n="btn_browse">Browse All Courses</a></p>
        </section>
    }
    else
    {
        <section class="class-sheet">
            <header class="class-head">
                <span class="class-folder" aria-hidden="true"><i class="bi bi-folder2"></i></span>
                <div>
                    <h2>@Model.Title</h2>
                    <p>@(string.IsNullOrWhiteSpace(Model.TeacherName) ? Model.TeacherEmail : Model.TeacherName)</p>
                </div>
            </header>
            @if (TempData["LearnNotice"] is string notice)
            {
                <p class="class-notice">@notice</p>
            }
            <p class="class-actions">
                <a asp-controller="Dashboard" asp-action="MyCourses" data-i18n="dash_my_courses">My Courses</a>
                <a asp-controller="Courses" asp-action="Details" asp-route-slug="@Model.Slug" data-i18n="btn_view_course">View course</a>
                @if (courseDone)
                {
                    <a asp-controller="Dashboard" asp-action="Certificate" asp-route-slug="@Model.Slug" data-i18n="cert_view">View Certificate</a>
                }
            </p>
            @if (courseDone)
            {
                <p class="class-notice">Every lesson is complete. Your certificate is ready.</p>
            }
            else
            {
                <p class="class-notice">The certificate appears when every lesson is complete.</p>
            }

            @if (current is not null)
            {
                var lesson = current.Lesson;
                <section class="class-player">
                    <h3>@lesson.Title</h3>
                    <p>@current.Module.Title · @lesson.Kind</p>
                    @if (lesson.Kind == "video" && !string.IsNullOrWhiteSpace(lesson.Video))
                    {
                        var remote = lesson.Video.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                        var src = remote ? lesson.Video : "/" + lesson.Video.TrimStart('/');
                        <div class="video-embed-wrap class-player-frame">
                            @if (remote)
                            {
                                <iframe class="video-embed" src="@src" title="@lesson.Title" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe>
                            }
                            else
                            {
                                <video class="video-embed" src="@src" title="@lesson.Title" controls playsinline></video>
                            }
                        </div>
                        <p>Video lesson. Complete it for +20 XP.</p>
                    }
                    else if (lesson.Kind == "quiz")
                    {
                        <p>Short quiz check. Complete it for +50 XP and +30 points.</p>
                    }
                    else if (lesson.Kind == "homework")
                    {
                        <p>Homework task. Complete it for +50 XP and +20 points.</p>
                    }
                    else if (lesson.Kind == "text" || lesson.Kind == "download")
                    {
                        <p>Read or download this lesson, then mark it complete for +20 XP.</p>
                    }
                    else
                    {
                        <p>This lesson has no video yet.</p>
                    }
                    @if (lesson.Completed)
                    {
                        <p>Completed</p>
                    }
                    else
                    {
                        <form asp-controller="Dashboard" asp-action="CompleteLesson" method="post">
                            <input type="hidden" name="slug" value="@Model.Slug" />
                            <input type="hidden" name="lessonId" value="@lesson.Id" />
                            <button class="btn btn-primary" type="submit">@(lesson.Kind == "quiz" ? "Complete quiz" : lesson.Kind == "homework" ? "Complete homework" : "Mark complete")</button>
                        </form>
                    }
                    <p><a asp-controller="Dashboard" asp-action="Learn" asp-route-slug="@Model.Slug">Back to class</a></p>
                </section>
            }

            @if (lessons.Count == 0)
            {
                <p>No class files yet.</p>
            }
            else
            {
                <div class="class-files">
                    @foreach (var item in lessons)
                    {
                        var lesson = item.Lesson;
                        var video = (lesson.Video ?? string.Empty).Replace('\\', '/');
                        var local = video.StartsWith("videos/lessons/", StringComparison.OrdinalIgnoreCase);
                        var src = local ? "/" + video.TrimStart('/') : null;
                        var fileName = local
                            ? System.IO.Path.GetFileNameWithoutExtension(video)
                            : $"{lesson.Order}-{lesson.Title}";
                        <article class="class-file">
                            <a class="class-file-thumb @(local ? null : "is-empty")" asp-controller="Dashboard" asp-action="Learn" asp-route-slug="@Model.Slug" asp-route-lessonId="@lesson.Id">
                                @if (local && src is not null)
                                {
                                    <video muted preload="metadata" src="@src" playsinline></video>
                                    <span class="class-play"><i class="bi bi-play-fill"></i></span>
                                }
                                else
                                {
                                    <i class="bi @(lesson.Kind == "quiz" ? "bi-ui-checks" : lesson.Kind == "homework" ? "bi-journal-text" : "bi-play-fill")"></i>
                                }
                            </a>
                            <a class="class-file-name" asp-controller="Dashboard" asp-action="Learn" asp-route-slug="@Model.Slug" asp-route-lessonId="@lesson.Id">@fileName</a>
                            <p class="class-file-meta">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(lesson.Kind)@(lesson.Completed ? " · Done" : null)</p>
                        </article>
                    }
                </div>
            }

            <section class="class-people">
                <h3><i class="bi bi-people"></i> Classmates</h3>
                @if (Model.Classmates.Count == 0)
                {
                    <p class="class-notice">No other students in this class yet.</p>
                }
                else
                {
                    <ul>
                        @foreach (var person in Model.Classmates)
                        {
                            var names = person.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initials = names.Length == 0 ? "?" : names.Length == 1
                                ? names[0][..1].ToUpperInvariant()
                                : (names[0][..1] + names[^1][..1]).ToUpperInvariant();
                            <li><span class="class-avatar">@initials</span> @person.Name</li>
                        }
                    </ul>
                }
            </section>
        </section>
    }
</div>
