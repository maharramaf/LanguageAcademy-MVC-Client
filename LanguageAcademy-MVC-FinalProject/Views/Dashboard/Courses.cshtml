@model List<CourseUIVM>
@{
    Layout = "_DashLayout";
}
<div class="dash-content">
    <section class="panel">
        <h2 data-i18n="nav_courses">Courses</h2>
        @if (Model.Count == 0)
        {
            <p>No courses yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th data-i18n="course_type">Course type</th>
                            <th data-i18n="label_level">Level</th>
                            <th data-i18n="label_duration">Duration</th>
                            <th>Lessons</th>
                            <th data-i18n="label_price">Price</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Type</td>
                                <td>@item.Level</td>
                                <td>@item.Duration</td>
                                <td>@item.LessonCount</td>
                                <td>
                                    @if (item.Price <= 0)
                                    {
                                        <text>Free</text>
                                    }
                                    else
                                    {
                                        <text>₼@item.Price.ToString("0")</text>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-outline btn-sm" asp-controller="Courses" asp-action="Details" asp-route-slug="@item.Slug" data-i18n="btn_view_course">View Course</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
