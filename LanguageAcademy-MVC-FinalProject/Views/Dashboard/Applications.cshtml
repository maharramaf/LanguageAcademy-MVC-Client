@model List<TeacherApplicationListUIVM>
@{
    Layout = "_DashLayout";
}
<div class="dash-content">
    <section class="panel">
        <h2 data-i18n="apply_admin">Teacher applications</h2>
        @if (TempData["ApplyNotice"] is string notice)
        {
            <p>@notice</p>
        }
        @if (TempData["ApplyPassword"] is string password)
        {
            <p>Temporary password: <strong>@password</strong></p>
        }
        @if (Model.Count == 0)
        {
            <p data-i18n="apply_empty">No teacher applications yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th data-i18n="label_name">Name</th>
                            <th data-i18n="label_email">Email</th>
                            <th data-i18n="studio_subject">Subject</th>
                            <th data-i18n="apply_experience">Experience</th>
                            <th data-i18n="apply_status">Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var pill = item.Status == "Approved" ? "pill-success"
                                : item.Status == "Rejected" ? "pill-info"
                                : "pill-warn";
                            <tr>
                                <td>@item.Name @item.Surname</td>
                                <td>@item.Email</td>
                                <td>@item.Subject</td>
                                <td>@item.Years</td>
                                <td>
                                    <span class="pill @pill">@item.Status</span>
                                </td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-controller="Dashboard" asp-action="AcceptApplication" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button class="btn btn-primary btn-sm" type="submit" data-i18n="apply_approve">Approve</button>
                                        </form>
                                        <form asp-controller="Dashboard" asp-action="RejectApplication" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button class="btn btn-outline btn-sm" type="submit" data-i18n="apply_reject">Reject</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
