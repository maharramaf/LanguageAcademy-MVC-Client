@model List<TeacherUIVM>
@{
    Layout = "_DashLayout";
}
<div class="dash-content">
    <section class="panel">
        <h2 data-i18n="nav_teachers">Teachers</h2>
        @if (Model.Count == 0)
        {
            <p>No teachers yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th data-i18n="label_name">Name</th>
                            <th>Role</th>
                            <th>Summary</th>
                            <th>LinkedIn</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(t => t.Order))
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Role</td>
                                <td>@item.Summary</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.LinkedIn))
                                    {
                                        <a href="@item.LinkedIn" target="_blank" rel="noopener">LinkedIn</a>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-outline btn-sm" asp-controller="Teachers" asp-action="Index" data-i18n="nav_teachers">View page</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
