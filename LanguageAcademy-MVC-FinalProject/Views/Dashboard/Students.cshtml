@model List<StudentAccountUIVM>
@{
    Layout = "_DashLayout";
}
<div class="dash-content">
    <section class="panel">
        <h2 data-i18n="nav_students">Students</h2>
        <p>Registered student accounts. Enrolled courses will appear here later.</p>
        @if (Model.Count == 0)
        {
            <p>No students yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th data-i18n="label_name">Name</th>
                            <th data-i18n="label_email">Email</th>
                            <th data-i18n="label_phone">Phone</th>
                            <th>Registered</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name @item.Surname</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
