@model CourseLessonsPageUIVM
@{
    Layout = "_DashLayout";
    var lessons = Model.Modules
        .OrderBy(m => m.Order)
        .SelectMany(m => m.Lessons.OrderBy(x => x.Order).Select(x => new { Module = m, Lesson = x }))
        .ToList();
}
<div class="dash-content class-page">
    <section class="class-sheet">
        <header class="class-head">
            <span class="class-folder" aria-hidden="true"><i class="bi bi-folder2"></i></span>
            <div>
                <h2>@Model.Title</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.TeacherName) ? "Teacher" : Model.TeacherName)</p>
            </div>
        </header>
        <p class="class-actions">
            <a asp-controller="Dashboard" asp-action="@(Roles.IsStaff(User) ? "Courses" : "Studio")">@(Roles.IsStaff(User) ? "Courses" : "Studio")</a>
            <a asp-controller="Courses" asp-action="Details" asp-route-slug="@Model.Slug">View course</a>
        </p>
        @if (TempData["CourseNotice"] is string notice)
        {
            <p class="class-notice">@notice</p>
        }
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        @if (lessons.Count == 0)
        {
            <p>No class files yet. Add a module and upload a video below.</p>
        }
        else
        {
            <div class="class-files">
                @foreach (var item in lessons)
                {
                    var lesson = item.Lesson;
                    var video = (lesson.Video ?? string.Empty).Replace('\\', '/');
                    var local = video.StartsWith("videos/lessons/", StringComparison.OrdinalIgnoreCase);
                    var remote = video.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                    var src = local ? "/" + video.TrimStart('/') : null;
                    var fileName = local
                        ? System.IO.Path.GetFileNameWithoutExtension(video)
                        : $"{lesson.Order}-{lesson.Title}";
                    <article class="class-file">
                        @if (local && src is not null)
                        {
                            <a class="class-file-thumb" asp-controller="Dashboard" asp-action="EditLesson" asp-route-id="@Model.Id" asp-route-moduleId="@item.Module.Id" asp-route-lessonId="@lesson.Id">
                                <video muted preload="metadata" src="@src" playsinline></video>
                                <span class="class-play"><i class="bi bi-play-fill"></i></span>
                            </a>
                        }
                        else
                        {
                            <a class="class-file-thumb is-empty" asp-controller="Dashboard" asp-action="EditLesson" asp-route-id="@Model.Id" asp-route-moduleId="@item.Module.Id" asp-route-lessonId="@lesson.Id">
                                <i class="bi @(lesson.Kind == "quiz" ? "bi-ui-checks" : lesson.Kind == "homework" ? "bi-journal-text" : "bi-play-fill")"></i>
                            </a>
                        }
                        <a class="class-file-name" asp-controller="Dashboard" asp-action="EditLesson" asp-route-id="@Model.Id" asp-route-moduleId="@item.Module.Id" asp-route-lessonId="@lesson.Id">@fileName</a>
                        <p class="class-file-meta">@(remote ? "Video" : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(lesson.Kind))</p>
                        <p class="class-file-tools">
                            <a asp-controller="Dashboard" asp-action="EditLesson" asp-route-id="@Model.Id" asp-route-moduleId="@item.Module.Id" asp-route-lessonId="@lesson.Id">Edit</a>
                            <form asp-controller="Dashboard" asp-action="DeleteLesson" asp-route-id="@Model.Id" asp-route-moduleId="@item.Module.Id" asp-route-lessonId="@lesson.Id" method="post" onsubmit="return confirm('Delete this lesson?');">
                                <button type="submit">Delete</button>
                            </form>
                        </p>
                    </article>
                }
            </div>
        }

        <section class="class-people">
            <h3><i class="bi bi-people"></i> Classmates</h3>
            @if (Model.Classmates.Count == 0)
            {
                <p class="class-notice">No students in this class yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var person in Model.Classmates)
                    {
                        var names = person.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        var initials = names.Length == 0 ? "?" : names.Length == 1
                            ? names[0][..1].ToUpperInvariant()
                            : (names[0][..1] + names[^1][..1]).ToUpperInvariant();
                        <li><span class="class-avatar">@initials</span> @person.Name</li>
                    }
                </ul>
            }
            <a class="class-invite" asp-controller="Dashboard" asp-action="Messages"><i class="bi bi-person-plus"></i> Invite people</a>
        </section>
    </section>

    <details class="class-manage" @(ViewData.ModelState.IsValid ? null : "open")>
        <summary>Add material</summary>
        <h3>New module</h3>
        <form asp-controller="Dashboard" asp-action="CreateModule" asp-route-id="@Model.Id" method="post" novalidate data-module-create>
            <div class="field">
                <label asp-for="Module.Title">Title</label>
                <input asp-for="Module.Title" type="text" maxlength="160" />
                <span asp-validation-for="Module.Title" class="field-error" data-error-for="Module.Title"></span>
            </div>
            <div class="field">
                <label asp-for="Module.Info">Info</label>
                <input asp-for="Module.Info" type="text" maxlength="80" placeholder="4 lessons · 45 min" />
                <span asp-validation-for="Module.Info" class="field-error" data-error-for="Module.Info"></span>
            </div>
            <p>
                <button class="btn btn-primary" type="submit">Add module</button>
            </p>
        </form>

    @if (Model.Modules.Count == 0)
    {
        <p class="class-notice">Add a module first, then upload numbered class videos.</p>
    }
    else
    {
        @foreach (var module in Model.Modules.OrderBy(m => m.Order))
        {
            <section>
                <h3>@module.Title</h3>
                <p>@module.Info</p>
                <p>
                    <a class="btn btn-outline btn-sm" asp-controller="Dashboard" asp-action="EditModule" asp-route-id="@Model.Id" asp-route-moduleId="@module.Id">Edit module</a>
                    <form asp-controller="Dashboard" asp-action="DeleteModule" asp-route-id="@Model.Id" asp-route-moduleId="@module.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this module and its lessons?');">
                        <button class="btn btn-outline btn-sm" type="submit">Delete module</button>
                    </form>
                </p>
                <h4>New lesson</h4>
                <p class="class-notice">Upload a video. Max 50 MB. Do not paste a YouTube URL.</p>
                <form asp-controller="Dashboard" asp-action="CreateLesson" asp-route-id="@Model.Id" asp-route-moduleId="@module.Id" method="post" enctype="multipart/form-data" novalidate data-lesson-create>
                    <div class="field">
                        <label for="Title-@module.Id">Title</label>
                        <input id="Title-@module.Id" name="Title" type="text" maxlength="160" />
                        <span class="field-error" data-error-for="Title"></span>
                    </div>
                    <div class="field">
                        <label for="Kind-@module.Id">Lesson type</label>
                        <select id="Kind-@module.Id" name="Kind">
                            <option value="video">Video</option>
                            <option value="text">Text</option>
                            <option value="quiz">Quiz</option>
                            <option value="homework">Homework</option>
                            <option value="download">Download</option>
                        </select>
                        <span class="field-error" data-error-for="Kind"></span>
                    </div>
                    <div class="field">
                        <label for="Seconds-@module.Id">Duration (seconds)</label>
                        <input id="Seconds-@module.Id" name="Seconds" type="number" min="0" step="1" value="0" />
                        <span class="field-error" data-error-for="Seconds"></span>
                    </div>
                    <div class="field">
                        <label for="Video-@module.Id">Video file</label>
                        <input id="Video-@module.Id" name="Video" type="file" accept=".mp4,.webm,.ogg,.ogv,video/mp4,video/webm,video/ogg" data-video-input />
                        <video class="lesson-video-preview" data-video-preview controls playsinline hidden></video>
                        <span class="field-error" data-error-for="Video"></span>
                    </div>
                    <p>
                        <button class="btn btn-primary" type="submit">Add lesson</button>
                    </p>
                </form>
            </section>
        }
    }
    </details>
</div>
<script>
    (function () {
        function bindRequired(form, names) {
            form.addEventListener("submit", function (event) {
                var ok = true;
                names.forEach(function (item) {
                    var input = form.querySelector("[name='" + item.name + "']");
                    var error = form.querySelector("[data-error-for='" + item.name + "']");
                    var field = input ? input.closest(".field") : null;
                    var value = (input && input.value ? input.value : "").trim();
                    var message = value ? "" : item.message;
                    if (field) field.classList.toggle("has-error", Boolean(message));
                    if (error) error.textContent = message;
                    if (message) ok = false;
                });
                var seconds = form.querySelector("[name='Seconds']");
                if (seconds) {
                    var error = form.querySelector("[data-error-for='Seconds']");
                    var field = seconds.closest(".field");
                    var message = Number(seconds.value) < 0 ? "Duration cannot be negative." : "";
                    if (field) field.classList.toggle("has-error", Boolean(message));
                    if (error) error.textContent = message;
                    if (message) ok = false;
                }
                if (!ok) event.preventDefault();
            });
        }

        var moduleForm = document.querySelector("[data-module-create]");
        if (moduleForm) {
            bindRequired(moduleForm, [
                { name: "Module.Title", message: "Module title is required." },
                { name: "Module.Info", message: "Module info is required." }
            ]);
        }

        document.querySelectorAll("[data-lesson-create]").forEach(function (form) {
            bindRequired(form, [
                { name: "Title", message: "Lesson title is required." },
                { name: "Kind", message: "Lesson type is required." }
            ]);

            var input = form.querySelector("[data-video-input]");
            var preview = form.querySelector("[data-video-preview]");
            if (input && preview) {
                input.addEventListener("change", function () {
                    var file = input.files && input.files[0];
                    if (preview.dataset.url) {
                        URL.revokeObjectURL(preview.dataset.url);
                        preview.dataset.url = "";
                    }
                    if (!file) {
                        preview.hidden = true;
                        preview.removeAttribute("src");
                        return;
                    }
                    var url = URL.createObjectURL(file);
                    preview.dataset.url = url;
                    preview.src = url;
                    preview.hidden = false;
                });
            }

            form.addEventListener("submit", function (event) {
                var kind = form.querySelector("[name='Kind']");
                if (!kind || kind.value.toLowerCase() !== "video") return;
                var video = form.querySelector("[name='Video']");
                var error = form.querySelector("[data-error-for='Video']");
                var field = video ? video.closest(".field") : null;
                var file = video && video.files && video.files[0];
                var message = file ? "" : "Choose an MP4, WEBM, or OGG video.";
                if (field) field.classList.toggle("has-error", Boolean(message));
                if (error) error.textContent = message;
                if (message) event.preventDefault();
            });
        });
    })();
</script>
