@model LanguageAcademy_MVC_FinalProject.ViewModels.Accounts.RegisterUIVM
@{
    Layout = "_AuthLayout";
    var ok = TempData["Register"] as string == "ok";
}

<main class="auth-page">
    <aside class="auth-aside">
        <a class="logo" asp-controller="Home" asp-action="Index">
            <span class="logo-mark">MF</span>
            <span class="logo-text"><strong>MF Language</strong><small>Academy</small></span>
        </a>
        <div class="auth-quote">
            <h2 data-i18n="auth_register_title">Start with a clear plan.</h2>
            <p data-i18n="auth_register_aside">Create a student profile, then choose a course that matches your level and schedule.</p>
        </div>
        <p><span data-i18n="x1iaxmzl">English, IELTS, German, Spanish, and more.</span></p>
    </aside>
    <section id="register-section" class="auth-panel">
        <div class="auth-card">
            <div class="header-tools">
                <div class="lang-switch">
                    <button class="lang-toggle" type="button" aria-haspopup="listbox" aria-expanded="false" data-i18n-aria-label="language_menu">
                        <span class="lang-current">AZ</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                    <ul class="lang-menu" role="listbox" hidden>
                        <li role="none"><button type="button" role="option" data-set-lang="az">🇦🇿 Azərbaycan</button></li>
                        <li role="none"><button type="button" role="option" data-set-lang="ru">🇷🇺 Русский</button></li>
                        <li role="none"><button type="button" role="option" data-set-lang="en">🇬🇧 English</button></li>
                    </ul>
                </div>
                <button class="theme-toggle" type="button" aria-pressed="false" data-i18n-aria-label="toggle_theme">
                    <i class="bi bi-moon-stars" aria-hidden="true"></i>
                </button>
            </div>
            <span class="eyebrow" data-i18n="auth_new">New student</span>
            <h1 data-i18n="nav_register">Register</h1>
            @if (ok)
            {
                <div class="form-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <h3>Your student account was created.</h3>
                    <p>You can sign in after the login page is connected.</p>
                    <p><a class="btn btn-primary" asp-controller="Home" asp-action="Index" data-i18n="nav_home">Home</a></p>
                </div>
            }
            else
            {
                <p>Create a student account. Instructor applications will come later.</p>
                <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="field-error"></div>
                    <div class="form-row">
                        <div class="field">
                            <label asp-for="Name" data-i18n="label_first">First Name</label>
                            <input asp-for="Name" autocomplete="given-name">
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Surname" data-i18n="label_last">Last Name</label>
                            <input asp-for="Surname" autocomplete="family-name">
                            <span asp-validation-for="Surname" class="field-error"></span>
                        </div>
                    </div>
                    <div class="field">
                        <label asp-for="Email" data-i18n="label_email">Email</label>
                            <input asp-for="Email" type="email" autocomplete="email">
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Phone" data-i18n="label_phone">Phone</label>
                            <input asp-for="Phone" type="tel" autocomplete="tel">
                        <span asp-validation-for="Phone" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Password" data-i18n="label_password">Password</label>
                        <div class="password-field">
                            <input asp-for="Password" type="password" autocomplete="new-password">
                            <button class="password-toggle" type="button" data-password-toggle aria-label="Show password" data-i18n-aria-label="show_password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword" data-i18n="label_confirm">Confirm Password</label>
                        <div class="password-field">
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password">
                            <button class="password-toggle" type="button" data-password-toggle aria-label="Show password" data-i18n-aria-label="show_password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                    <button class="btn btn-secondary btn-block" type="submit" data-i18n="nav_register">Register</button>
                </form>
            }
            <p class="auth-switch"><span data-i18n="x122cfat">Already have an account?</span> <a href="login.html" data-i18n="nav_login">Login</a></p>
            <p><a asp-controller="Home" asp-action="Index" data-i18n="auth_back">Back to website</a></p>
        </div>
    </section>
</main>
